{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "1120px", "wideSize": "1120px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "name": "Ink (navy)", "color": "#1f2044" },
				{ "slug": "paper", "name": "Paper", "color": "#ffffff" },
				{ "slug": "cream", "name": "Cream", "color": "#f5f4f0" },
				{ "slug": "line", "name": "Hairline", "color": "#e1ddd6" },
				{ "slug": "muted", "name": "Muted", "color": "#5f6075" },
				{ "slug": "gold", "name": "Gold", "color": "#b99e64" },
				{ "slug": "gold-ink", "name": "Gold (text-safe)", "color": "#7d6633" },
				{ "slug": "sage", "name": "Sage", "color": "#5ca595" },
				{ "slug": "sage-ink", "name": "Sage (text-safe)", "color": "#2f6b5e" },
				{ "slug": "terracotta", "name": "Terracotta", "color": "#c06451" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Montserrat",
					"fontFamily": "\"Montserrat\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/montserrat-latin-var.woff2"]
						}
					]
				},
				{
					"slug": "body",
					"name": "Open Sans",
					"fontFamily": "\"Open Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Open Sans",
							"fontWeight": "300 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/open-sans-latin-var.woff2"]
						},
						{
							"fontFamily": "Open Sans",
							"fontWeight": "300 800",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/open-sans-latin-italic-var.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "3.75rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } },
				{ "slug": "huge", "name": "Huge", "size": "8.5rem", "fluid": { "min": "3.25rem", "max": "8.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 3vw, 2rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 5vw, 4rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 8vw, 7rem)" }
			]
		},
		"custom": {
			"radius": "2px",
			"ease": "cubic-bezier(.2,.7,.2,1)",
			"ease-spring": "linear(0, 0.063, 0.198, 0.368, 0.544, 0.697, 0.837, 0.947, 1.025, 1.075, 1.1, 1.108, 1.102, 1.087, 1.069, 1.052, 1.034, 1.019, 1.006, 0.998, 0.992, 0.989, 0.988, 0.989, 0.99, 0.992, 0.994, 0.996, 0.998, 0.999, 1)",
			"ease-settle": "linear(0, 0.038, 0.115, 0.211, 0.304, 0.402, 0.493, 0.574, 0.645, 0.706, 0.755, 0.799, 0.836, 0.867, 0.892, 0.913, 0.93, 0.943, 0.954, 0.963, 0.97, 0.976, 0.981, 0.985, 0.988, 0.99, 0.992, 0.994, 0.995, 0.996, 0.997, 0.998, 0.999, 1)",
			"ease-bounce": "linear(0, 0.143, 0.438, 0.767, 1.03, 1.209, 1.279, 1.261, 1.187, 1.095, 1.014, 0.954, 0.925, 0.923, 0.94, 0.965, 0.99, 1.008, 1.02, 1.022, 1.019, 1.012, 1.005, 0.999, 0.995, 0.994, 0.994, 0.996, 0.998, 1, 1.001, 1.002, 1.001, 1)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": { "blockGap": "var(--wp--preset--spacing--30)" },
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1.02",
					"letterSpacing": "-0.01em",
					"textTransform": "uppercase"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--sage-ink)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--paper)" },
				"border": { "radius": "var(--wp--custom--radius)" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.75rem", "right": "1.75rem" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "0.8125rem",
					"fontWeight": "700",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				":hover": { "color": { "background": "var(--wp--preset--color--sage-ink)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--gold)", "offset": "3px", "style": "solid", "width": "2px" } }
			}
		}
	},
	"templateParts": [{ "name": "header", "title": "Header", "area": "header" }]
}
