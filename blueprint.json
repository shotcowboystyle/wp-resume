{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"meta": {
		"title": "Curtis Blanton: resume as a WordPress site",
		"description": "Block theme + custom Gutenberg blocks (timeline, skills, metrics, payroll calculator, A/B experiment) with SEO, tracking and admin plugins.",
		"author": "shotcowboystyle",
		"categories": [
			"Theme",
			"Blocks"
		]
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "wordpress-seo"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "duracelltomi-google-tag-manager"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "advanced-custom-fields"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "performance-lab"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "accessibility-checker"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "redirection"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "query-monitor"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "simple-history"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/shotcowboystyle/wp-resume",
				"ref": "main",
				"refType": "branch",
				"path": "theme/cb-resume"
			},
			"options": {
				"activate": true,
				"targetFolderName": "cb-resume"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/shotcowboystyle/wp-resume",
				"ref": "main",
				"refType": "branch",
				"path": "plugin/cb-resume-blocks"
			},
			"options": {
				"activate": true,
				"targetFolderName": "cb-resume-blocks"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php';\n// Skip first-run wizards so the resume is the first thing a visitor sees.\nupdate_option('wpseo', array_merge((array) get_option('wpseo'), ['should_redirect_after_install_free' => false, 'show_onboarding_notice' => false]));\ndelete_transient('_wpseo_activation_redirect');\nupdate_option('gtm4wp-options', array_merge((array) get_option('gtm4wp-options'), ['gtm-code' => '', 'gtm-datalayer-variable-name' => 'dataLayer']));\n// Open the editor straight onto the blocks, not the welcome tour.\nupdate_user_meta(1, 'wp_persisted_preferences', ['core/edit-post' => ['welcomeGuide' => false], 'core' => ['welcomeGuide' => false], '_modified' => gmdate('c')]);"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; cb_resume_seed();"
		}
	]
}
