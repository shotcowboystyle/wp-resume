{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cb/stage",
  "title": "Product scene (stageshow)",
  "category": "cb-resume",
  "icon": "format-video",
  "description": "An animated product scene built with stageshow. Server-renders a sized poster (no layout shift), loads the scene only near the viewport, and never loads it under reduced motion.",
  "attributes": {
    "scene": {
      "type": "string",
      "enum": [
        "onpay-dashboard",
        "onpay-expert"
      ],
      "default": "onpay-dashboard"
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "priority": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true
    }
  },
  "textdomain": "cb-resume-blocks",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}